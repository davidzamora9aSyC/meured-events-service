generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeuredEventStatus {
  DRAFT
  PUBLISHED
  CANCELED
  DELETED
}

enum MeuredRsvpStatus {
  GOING
  INTERESTED
}

model MeuredEvent {
  id               String            @id @default(uuid())
  createdByAuthUserId String
  organizerEntityId String?
  title            String
  description      String
  startAt          DateTime
  endAt            DateTime
  status           MeuredEventStatus @default(PUBLISHED)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  rsvps MeuredEventRsvp[]

  @@index([createdByAuthUserId])
  @@index([organizerEntityId])
  @@index([startAt])
  @@index([status])
}

model MeuredEventRsvp {
  id        String        @id @default(uuid())
  eventId   String
  authUserId String
  status    MeuredRsvpStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  event MeuredEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, authUserId])
  @@index([authUserId])
}

